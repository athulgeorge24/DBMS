SELECT AVG(PHYSICS) AS avg_physics FROM student1;

SELECT MAX(MATHS) AS highest_marks_maths FROM student1;

SELECT MIN (CHEMISTRY) AS lowest_mark_chemistry FROM student1;

SELECT COUNT(*) AS pass_physics FROM student1 WHERE physics >= 12;
SELECT ROLL_NO,NAME FROM student1 WHERE PHYSICS >= 12 AND CHEMISTRY >= 12 AND MATHS >=25;

ALTER table student1 add(status VARCHAR(10));
update student1 set status='PASS' WHERE PHYSICS >= 12 AND CHEMISTRY >= 12 AND MATHS >=25;
update student1 set status='FAIL' WHERE PHYSICS < 12 OR CHEMISTRY < 12 OR MATHS < 25;

SELECT ROLL_NO,NAME,PHYSICS+CHEMISTRY+MATHS AS TOTAL_MARKS FROM student1 ORDER BY TOTAL_MARKS DESC;

ALTER table student1 add(TOTAL_MARKS INT);

update student1 set total_marks=PHYSICS+CHEMISTRY+MATHS;

select count(*)*100/10 as pass_percentage_maths from student1 where maths >=25;

select count(*)*100/10 as pass_percentage from student1 where PHYSICS >= 12 AND CHEMISTRY >= 12 AND MATHS >=25;

SELECT AVG(PHYSICS+MATHS++CHEMISTRY) AS CLASS_AVG FROM student1;

select count(*) AS PASS_STUDENTS from student1 where STATUS ='PASS';
